# Copy this to .env and replace <db_password> with your Atlas password
MONGODB_URI=MongoDB connection string
JWT_SECRET=change_this_in_production
FRONTEND_URL=http://localhost:5000
PORT=5000

# Shopify (dropshipping catalog sync + order forwarding to DSers)
# Leave blank to disable Shopify sync/forwarding entirely.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# Only needed temporarily to run the one-time OAuth bootstrap at
# /api/shopify/install?shop=your-store.myshopify.com (see routes/shopifyInstall.js).
# Safe to remove from .env once you have SHOPIFY_ACCESS_TOKEN above.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
